  issn = {15459985},
  doi = {10.1038/nsmb.2941},
  abstract = {Kinases perform phosphoryl-transfer reactions in milliseconds; without enzymes, these reactions would take about 8,000 years under physiological conditions. Despite extensive studies, a comprehensive understanding of kinase energy landscapes, including both chemical and conformational steps, is lacking. Here we scrutinize the microscopic steps in the catalytic cycle of adenylate kinase, through a combination of NMR measurements during catalysis, pre-steady-state kinetics, molecular-dynamics simulations and crystallography of active complexes. We find that the Mg2+ cofactor activates two distinct molecular events: phosphoryl transfer ({$>$}105-fold) and lid opening (103-fold). In contrast, mutation of an essential active site arginine decelerates phosphoryl transfer 103-fold without substantially affecting lid opening. Our results highlight the importance of the entire energy landscape in catalysis and suggest that adenylate kinases have evolved to activate key processes simultaneously by precise placement of a single, charged and very abundant cofactor in a preorganized active site.},
