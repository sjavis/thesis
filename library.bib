@article{Li2016,
  title = {Lattice {{Boltzmann}} Methods for Multiphase Flow and Phase-Change Heat Transfer},
  author = {Li, Q. and Luo, K.H. and Kang, Q.J. and He, Y.L. and Chen, Q. and Liu, Q.},
  year = {2016},
