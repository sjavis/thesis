@article{Wang2019,
  title = {Modelling Double Emulsion Formation in Planar Flow-Focusing Microchannels},
  author = {Wang, Ningning and Semprebon, Ciro and Liu, Haihu and Zhang, Chuhua and Kusumaatmaja, Halim},
