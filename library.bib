}

@article{Liu2018,
  title = {Topological Kinematics of Origami Metamaterials},
  author = {Liu, Bin and Silverberg, Jesse L. and Evans, Arthur A. and Santangelo, Christian D. and Lang, Robert J. and Hull, Thomas C. and Cohen, Itai},
