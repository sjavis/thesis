@article{Kim2018,
  title = {Printing Ferromagnetic Domains for Untethered Fast-Transforming Soft Materials},
  author = {Kim, Yoonho and Yuk, Hyunwoo and Zhao, Ruike and Chester, Shawn A. and Zhao, Xuanhe},
